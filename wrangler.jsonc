{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tapjournal",
	"compatibility_date": "2026-11-25",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "D1_DB",
			"database_name": "tapjournal",
			"database_id": "59895cd7-1ef8-46f3-8663-275348d2c9e6",
			"migrations_dir": "migrations"
		}
	],
	"workers_dev": true,
	"preview_urls": true
}
